<ui version="4.0">
 <class>RecordPicker</class>
 <widget class="QDialog" name="dialog_record_picker">
  <property name="windowTitle"><string>Select linked records</string></property>
  <property name="minimumSize"><size><width>560</width><height>380</height></size></property>
  <layout class="QVBoxLayout" name="layout_records">
   <item><widget class="QLabel" name="label_instructions"><property name="text"><string>Select one or more records to link.</string></property></widget></item>
   <item><widget class="QTableView" name="table_records">
    <property name="selectionBehavior"><enum>QAbstractItemView::SelectRows</enum></property>
    <property name="selectionMode"><enum>QAbstractItemView::ExtendedSelection</enum></property>
    <property name="sortingEnabled"><bool>true</bool></property>
   </widget></item>
   <item><widget class="QDialogButtonBox" name="buttons_records"><property name="standardButtons"><set>QDialogButtonBox::Cancel|QDialogButtonBox::Ok</set></property></widget></item>
  </layout>
 </widget>
